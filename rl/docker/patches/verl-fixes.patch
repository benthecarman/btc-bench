     2. Partial rollout is disabled
     """
 
+    def step(self, metrics, timing_raw, *, prefetch_next_batch=True):
+        # Sync mode queues no warmup batch: the batch added in step() is the
+        # one this step trains on, so the last step must add it too or it
+        # waits forever for a rollout that was never requested.
+        return super().step(metrics, timing_raw, prefetch_next_batch=True)
+
     def on_init_end(self):
         # update weights after loading checkpoint
         self.checkpoint_manager.update_weights(self.global_steps)
